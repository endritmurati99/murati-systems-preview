{
	email info@muratisystems.de
}

muratisystems.de {
	root * /srv/site
	encode zstd gzip
	handle /api/* {
		request_body {
			max_size 20KB
		}
		reverse_proxy anfrage:8080
	}
	handle {
		file_server
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'"
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
}

www.muratisystems.de {
	redir https://muratisystems.de{uri} permanent
}

# MTA-STS (RFC 8461): fremde Mailserver liefern an @muratisystems.de nur noch verschlüsselt.
# Voraussetzung: DNS A mta-sts -> 76.13.154.245. Erst danach TXT _mta-sts setzen.
# Policy ändern (z. B. testing -> enforce) = id im TXT-Eintrag _mta-sts erhöhen.
mta-sts.muratisystems.de {
	header Content-Type "text/plain; charset=utf-8"
	respond /.well-known/mta-sts.txt `version: STSv1
mode: testing
mx: mx1.hostinger.com
mx: mx2.hostinger.com
max_age: 86400
` 200
	respond 404
}

# Kurzer Weg ins Postfach: webmail.muratisystems.de -> Hostinger-Webmail.
# Eigene Weiterleitung statt CNAME, weil das Hostinger-Zertifikat die eigene Domain nicht abdeckt.
webmail.muratisystems.de {
	redir https://mail.hostinger.com/ 302
}
